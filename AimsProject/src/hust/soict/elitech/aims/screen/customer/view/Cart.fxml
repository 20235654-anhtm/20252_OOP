<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hust.soict.dsai.aims.screen.customer.controller.CartController">
    <top>
        <HBox alignment="CENTER" prefHeight="100.0" style="-fx-border-color: black; -fx-border-width: 0 0 1 0;">
            <Label text="CART" textFill="#004cff">
                <font>
                    <Font size="50.0" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnViewStore" mnemonicParsing="false" onAction="#btnViewStorePressed" text="View Store" />
        </HBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Filter:" />
                <TextField fx:id="tfFilter" />
                <RadioButton fx:id="radioBtnFilterId" mnemonicParsing="false" text="By ID" />
                <RadioButton fx:id="radioBtnFilterTitle" mnemonicParsing="false" text="By Title" />
            </HBox>
            <TableView fx:id="tblMedia">
                <columns>
                    <TableColumn fx:id="colMediaId" text="ID" />
                    <TableColumn fx:id="colMediaTitle" text="Title" />
                    <TableColumn fx:id="colMediaCategory" text="Category" />
                    <TableColumn fx:id="colMediaCost" text="Cost" />
                </columns>
            </TableView>
            <HBox alignment="TOP_RIGHT" spacing="20.0">
                <Button fx:id="btnPlay" mnemonicParsing="false" onAction="#btnPlayPressed" text="Play" />
                <Button fx:id="btnRemove" mnemonicParsing="false" onAction="#btnRemovePressed" text="Remove" />
            </HBox>
        </VBox>
    </center>
    <bottom>
        <VBox alignment="TOP_CENTER" spacing="30.0" prefHeight="200.0">
            <HBox alignment="CENTER">
                <Label text="Total:" style="-fx-font-weight: bold; -fx-font-size: 24;">
                    <padding>
                        <Insets right="10.0" />
                    </padding>
                </Label>
                <Label fx:id="costLabel" style="-fx-font-weight: bold; -fx-font-size: 24;" text="0 $" />
            </HBox>
            <Button onAction="#btnPlaceOrderPressed" text="Place Order" style="-fx-background-color: #004cff; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 24;" />
        </VBox>
    </bottom>
</BorderPane>